#!/usr/bin/env python3
# TFVC unified diff -> UTF-8. Encoding differs per line (Big5 headers/local file, UTF-8 server side):
# a line that is valid UTF-8 stays; otherwise it is decoded as CP950.
import sys
out = sys.stdout.buffer
for line in sys.stdin.buffer:
    try:
        line.decode("utf-8")
        out.write(line)
    except UnicodeDecodeError:
        out.write(line.decode("cp950", "replace").encode("utf-8"))
